{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docking-genotype-v1",
  "title": "Canonical docking genotype",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "genotype_id",
    "receptor",
    "mutations"
  ],
  "properties": {
    "schema": {
      "const": "docking-genotype-v1"
    },
    "genotype_id": {
      "type": "string",
      "minLength": 1
    },
    "receptor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$"
    },
    "mutations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "position",
          "wt",
          "mut"
        ],
        "properties": {
          "position": {
            "type": "integer",
            "minimum": 1
          },
          "wt": {
            "type": "string",
            "pattern": "^[ACDEFGHIKLMNPQRSTVWY]$"
          },
          "mut": {
            "type": "string",
            "pattern": "^[ACDEFGHIKLMNPQRSTVWY]$"
          }
        }
      }
    }
  }
}

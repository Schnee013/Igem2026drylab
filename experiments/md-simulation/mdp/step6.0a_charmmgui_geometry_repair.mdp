; Controlled pre-minimization repair for CHARMM-GUI membrane coordinates.
; Operational use requires a frozen system-specific geometry contract and must
; be followed by the package's original constrained step6.0 minimization.
define                  = -DPOSRES -DPOSRES_FC_BB=4000.0 -DPOSRES_FC_SC=2000.0 -DPOSRES_FC_LIPID=1000.0 -DDIHRES -DDIHRES_FC=1000.0
integrator              = steep
emtol                   = 1000.0
nsteps                  = 500
nstlist                 = 10
cutoff-scheme           = Verlet
rlist                   = 1.2
vdwtype                 = Cut-off
vdw-modifier            = Force-switch
rvdw_switch             = 1.0
rvdw                    = 1.2
coulombtype             = PME
rcoulomb                = 1.2
emstep                  = 0.001
constraints             = none
constraint_algorithm    = LINCS

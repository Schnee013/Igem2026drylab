# =====================================================================
# iGEM 2026 Dry Lab — .gitignore
# =====================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Conda environments (not committed — use conda env export)
.conda/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# =====================================================================
# 计算产出（大文件 / 可重新生成）
# =====================================================================

# v2 pipeline 产出（PDBQT、pose 文件、交互分析）
experiments/docking/prepared/
experiments/docking/results/poses/
experiments/docking/results/interactions/
experiments/docking/results/docking_results.json
experiments/docking/results/blind_validation.json

# docking-repro 产出
experiments/docking-repro/prepared/
experiments/docking-repro/results/
experiments/docking-repro/ligands/orca/
experiments/docking-repro/mutagenesis/*.json
experiments/docking-repro/mutagenesis/*.md
experiments/docking-repro/mutagenesis/af2_structures/
experiments/docking-repro/mutagenesis/af2_prepared/
experiments/docking-repro/mutagenesis/af3_downloads/
experiments/docking-repro/mutagenesis/af3_structures/
experiments/docking-repro/mutagenesis/af3_prepared/

# chimeric-gpa1 AF3 产出（2.9 GB，可从 AF3 Server 重新下载）
experiments/chimeric-gpa1/af3_predictions/downloads/

# literature-research API/run state; curated matrices, summaries, and
# explicitly referenced source attachments stay trackable.
experiments/chimeric-gpa1/literature/research_runs/

# Local literature source binaries stay outside git; keep checksums and
# pointer README files trackable.
experiments/chimeric-gpa1/literature/source_attachments/*.pdf
experiments/chimeric-gpa1/literature/source_attachments/*.zip

# 日志（运行日志不入库，但保留目录）
experiments/docking/logs/*.log
experiments/docking-repro/logs/*.log
experiments/docking-repro/logs/*.err

# MD trajectory / large simulation outputs
experiments/md-simulation/results/**/raw/
experiments/md-simulation/results/**/processed/
experiments/md-simulation/results/**/processed_*/
experiments/md-simulation/results/**/analysis_mol_invalid/
experiments/md-simulation/results/**/*.xtc
experiments/md-simulation/results/**/*.trr
experiments/md-simulation/results/**/*.tpr
experiments/md-simulation/results/**/*.edr
experiments/md-simulation/results/**/*.cpt
experiments/md-simulation/results/**/toppar/
experiments/md-simulation/results/**/analysis/**/snapshots/*.pdb
experiments/md-simulation/results/**/work/
experiments/md-simulation/results/**/production_smoke/
experiments/md-simulation/results/**/input/gromacs/
experiments/md-simulation/results/**/*.log

# MD system build/runtime byproducts under gromacs/. Canonical builder inputs
# such as README, topologies, MDPs, index files, and step5_input.* remain visible.
experiments/md-simulation/systems/**/gromacs/*.tpr
experiments/md-simulation/systems/**/gromacs/*.edr
experiments/md-simulation/systems/**/gromacs/*.cpt
experiments/md-simulation/systems/**/gromacs/*.xtc
experiments/md-simulation/systems/**/gromacs/*.trr
experiments/md-simulation/systems/**/gromacs/*_out.mdp
experiments/md-simulation/systems/**/gromacs/em.gro
experiments/md-simulation/systems/**/gromacs/step6.[0-9]*.gro
experiments/md-simulation/systems/**/gromacs/*.log
experiments/md-simulation/systems/**/gromacs/*.sha256
experiments/md-simulation/systems/**/source_archives/

# R1 chctrl prototype payload policy: keep route/build notes/checksums/static
# validation, but do not commit the copied CHARMM-GUI GROMACS input package.
experiments/md-simulation/systems/chimeric-ste2-gpa1-wt/r1_tight_full_rebuild_chctrl/gromacs/**

# =====================================================================
# 保留（明确 track 的内容）
# =====================================================================

# 原始受体 PDB（AlphaFold 结构，小文件，需版本控制）
!experiments/docking/receptors/*.pdb

# 原始配体 SDF/MOL2（PubChem 下载，需版本控制）
!experiments/docking/ligands/*.sdf
!experiments/docking/ligands/*.mol2

# 分析产出（CSV、图表、验证报告）
!experiments/docking/analysis/
!experiments/docking-repro/analysis/

# 日志目录本身（空目录占位）
!experiments/docking/logs/.gitkeep
!experiments/docking-repro/logs/.gitkeep

# =====================================================================
# 文献 PDF（通常较大，不入库；summaries 文本入库）
# =====================================================================
docs/papers/pdf/

# Presentation reference binaries are local source material; keep text
# manifests/notes tracked separately.
docs/presentation/reference-materials/*.pdf
docs/presentation/reference-materials/*.pptx
docs/presentation/reference-materials/*.png
docs/presentation/reference-materials/*.svg

# 合作伙伴 / 赞助 / 外联材料含隐私信息，默认不入库
docs/partners/

# =====================================================================
# Claude Code 私有配置
# =====================================================================
.claude/
.claude.json
.claude.json.backup

# Codex repo-local private config. Keep `.codex/hooks*` tracked separately.
.codex/config.toml

# IDE
.vscode/
.idea/
*.swp
*.swo

# 临时文件
temp/
tmp_papers/
*.tmp
*.bak
*.orig
/*.zip

# =====================================================================
# 凭证与敏感文件（安全审计 2026-04-06 新增）
# =====================================================================
.env*
*.pem
*.key
*.p12
*.pfx
credentials*
*secret*
